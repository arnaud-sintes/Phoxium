#version 450
#extension GL_GOOGLE_include_directive : require

// Slot `screen` (ARCHITECTURE 3.7, image contract): amp domain (gun output, beam current) -> tube domain
// (one texel per host pixel of the tube rectangle, tube_size), linear light emitted per channel in the
// product form L_c = mask_eval() * beam_eval(). With the T-20b stubs (nearest amp sample, mask 1.0) it is
// an exact identity: 1.0 * x is x.

#include "params.glsl"
#include "common.glsl"
// T-37: the ABL state (set 1, read only) for raster_scale, and the geometry hooks beam.glsl calls. abl_runs (push
// constant, src/gpu/stages/screen.rs): the `abl` slot runs in this frame, so its state is current (otherwise
// raster_scale is 1).
layout(push_constant) uniform ScreenPush {
    uint abl_runs;
} screen_push;
// Bit 0 of `abl_runs`: the `abl` slot runs; bit 1 (warp path): the aligned grid (see beam_warp.glsl).
#define GEOMETRY_ABL_RUNS ((screen_push.abl_runs & 1u) != 0u)
#define ABL_STATE_QUALIFIER readonly
#include "abl.glsl"
#include "geometry.glsl"
#include "beam.glsl"
#include "mask.glsl"

// One workgroup per beam tile (standard quality shares the line profiles of the tile, beam.glsl T-36c);
// the dispatch uses the same size (gpu/stages/screen.rs SCREEN_GROUP).
layout(local_size_x = BEAM_TILE_W, local_size_y = BEAM_TILE_H) in;

layout(set = 0, binding = 2) uniform sampler2D current_in;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D light_out;

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    // The whole workgroup evaluates the standard-quality beam (barriers) before any invocation returns;
    // beam_eval then gives its result for q.
    beam_eval_workgroup(current_in, q);
    if (any(greaterThanEqual(q, frame.tube_size))) {
        return;
    }
    vec3 l = mask_eval(q) * beam_eval(current_in, q);
    // T-37 review F1: the light is clipped to the visible opening (geometry.glsl): exactly 1 inside, 0 outside.
    l *= geometry_opening_coverage(q);
    imageStore(light_out, q, round_f16(vec4(l, 1.0)));
}
