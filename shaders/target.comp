#version 450
#extension GL_GOOGLE_include_directive : require

// Slot `target` (the source colour target, `source_colour_target`; native domain -> native domain, drive voltage R'G'B'
// right after `decode`, before the signal modules). Skipped as an exact identity while the target is `none`
// (`Stage::is_identity`).
//
// One thread per native pixel: the colour a device (Game Boy Color, Game Boy Advance, SNES) would have shown, by the
// formulas of the f64 oracle `crates/crt-model/src/target.rs` (read it first; the CPU builds the constants from the
// target's data file, `stages/target.rs`, `src/targets.rs`). First the device codes are recovered when the pixel
// allows it (`bits` > 0, the oracle's `device_codes`): when all three channels are exactly the expansion of a
// `bits`-bit code to 8 bits (the bits repeated, `c << (8 - bits) | c >> (2 bits - 8)`), x is c / (2^bits - 1), so that
// the formula sees the device codes exactly; any other colour is transformed as it is (x = V). Then, by `kind`:
//   0 matrix: l = input_range x x^input_gamma, s = clamp(K l, 0, clamp), V' = out_scale (s / divisor)^inv_out_gamma;
//   1 curve:  V' = out_scale x table[x x 31], linearly interpolated between two entries (32 entries of 8 bits, four to
//             a word).
//   2 palette: the luma of V (BT.601) picks a position between four colours (lightest first, three bytes each in the
//             first three words of `table`): V' = out_scale x lerp(colour[i], colour[i + 1], f), (i, f) the whole and
//             fractional part of (1 - luma) x 3. No device code is recovered (bits = 0).
//   3 dac:    V' = out_scale x piecewise linear map through the points (in[i], out[i]) (the 8-bit levels the emulator
//             shows, the measured output codes; bytes 0 to 7 of `table` for the inputs, 8 to 15 the output codes of red,
//             16 to 23 of green, 24 to 31 of blue, the same eight three times for a dac with no channel of its own),
//             V x 255 held to the first and last input level; fewer than eight points repeat the last. No device code
//             is recovered (bits = 0).
//   5 dac15:  the same map for a dac of 9 to 15 points (the Mega Drive's normal, shadow and highlight levels on the 15
//             levels of its divider) with the same output codes on the three channels: bytes 0 to 14 of `table` for the
//             inputs, 15 to 29 for the outputs; fewer than fifteen points repeat the last. V' = out_scale x map(V x 255),
//             as kind 3. No device code is recovered (bits = 0).
//   4 signal: the nearest of `table[0]` reference colours (`frame.target_table[256 + i].rgb`, what an emulator shows)
//             classifies the pixel; it is replaced by that hardware colour (`frame.target_table[i].rgb`, the drive
//             voltages) when the distance is at most `clamp_sum` (the threshold); the first of equal distances wins; a
//             pixel with no close colour passes through. No device code is recovered (bits = 0).
//   6 lut:    the PC Engine's 512 colours: when all three channels are 3-bit levels (n = (code + 18) / 36, the code being
//             255 n / 7 rounded or 36 n, `lut_index`) the pixel is replaced by `frame.target_table[G x 64 + R x 8 + B].rgb`
//             (the drive voltages of the colour code, decoded on the CPU for the chosen variant); any other pixel passes
//             through. The table shares the frame block with the signal kind (one target at a time). No device code is
//             recovered (bits = 0).
// Alpha is copied.

#include "params.glsl"
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 2) uniform sampler2D drive_in;                    // native domain
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D drive_out;  // native domain

// The constants (std430 push block, 100 bytes; `target::Push`).
layout(push_constant) uniform Push {
    float k00;
    float k01;
    float k02;
    float k10;
    float k11;
    float k12;
    float k20;
    float k21;
    float k22;
    float input_range;
    float input_gamma;    // 1 = none
    float clamp_sum;      // the largest sum
    float divisor;
    float inv_out_gamma;  // 1 = none
    float out_scale;
    uint table[8];        // the curve, entry i in byte i % 4 of word i / 4
    int bits;             // bits per channel of the device code, 4 to 7; 0 = no recovery
    int kind;             // 0 matrix, 1 curve, 2 palette, 3 dac, 4 signal, 5 dac15, 6 lut
} pc;

// Tolerance of the recovery in 8-bit code units (`crt_model::target::RECOVERY_TOLERANCE`).
const float RECOVERY_TOLERANCE = 0.1;
const int CURVE_LAST = 31;
// Where the reference colours start in `frame.target_table` (`crt_model::target::SIGNAL_MAX`, a test checks it).
const int TABLE_REFERENCES = 256;

// The input of the transform with the device codes recovered, when every channel is exactly an expansion.
vec3 device_input(vec3 v) {
    if (pc.bits == 0) {
        return v;
    }
    vec3 code = clamp(v * 255.0, vec3(0.0), vec3(255.0));
    vec3 r = round(code);
    if (any(greaterThan(abs(code - r), vec3(RECOVERY_TOLERANCE)))) {
        return v;
    }
    int shift = 8 - pc.bits;
    ivec3 ci = ivec3(r);
    ivec3 c = ci >> shift;
    ivec3 expanded = (c << shift) | (c >> (pc.bits - shift));
    if (any(notEqual(expanded, ci))) {
        return v;
    }
    return vec3(c) / float((1 << pc.bits) - 1);
}

float curve_entry(int i) {
    return float((pc.table[i >> 2] >> uint((i & 3) * 8)) & 255u);
}

// Colour `j` (0 lightest) of the palette: three bytes, channel c of colour j at byte 3 j + c of `table`.
vec3 palette_colour(int j) {
    int b = 3 * j;
    return vec3(float((pc.table[(b + 0) >> 2] >> uint(((b + 0) & 3) * 8)) & 255u),
                float((pc.table[(b + 1) >> 2] >> uint(((b + 1) & 3) * 8)) & 255u),
                float((pc.table[(b + 2) >> 2] >> uint(((b + 2) & 3) * 8)) & 255u));
}

vec3 palette(vec3 v) {
    float pos = (1.0 - clamp(dot(v, vec3(0.299, 0.587, 0.114)), 0.0, 1.0)) * 3.0;
    int i = min(int(floor(pos)), 2);
    return mix(palette_colour(i), palette_colour(i + 1), pos - float(i));
}

// Byte `i` of `table` (the dac's eight input levels, then its eight output codes of red, of green and of blue).
float table_byte(int i) {
    return float((pc.table[i >> 2] >> uint((i & 3) * 8)) & 255u);
}

// The dac of channel `ch` (0 red, 1 green, 2 blue): its output codes start at byte 8 + 8 ch. A dac of fewer than eight
// codes repeats its last point (the loop never takes a segment that starts at a repeat, so no division by zero).
float dac(float x, int ch) {
    int o = 8 + 8 * ch;
    float p = clamp(x * 255.0, table_byte(0), table_byte(7));
    int i = 0;
    for (int k = 0; k < 6; k++) {
        if (p > table_byte(k + 1)) {
            i = k + 1;
        }
    }
    float x0 = table_byte(i);
    float x1 = table_byte(i + 1);
    return mix(table_byte(o + i), table_byte(o + 1 + i), (p - x0) / (x1 - x0));
}

// The dac of 15 points (kind 5): inputs at bytes 0 to 14, outputs at 15 to 29, the same on the three channels. Fewer points
// repeat the last (a segment that starts at a repeat is never taken, so no division by zero).
float dac15(float x) {
    float p = clamp(x * 255.0, table_byte(0), table_byte(14));
    int i = 0;
    for (int k = 0; k < 13; k++) {
        if (p > table_byte(k + 1)) {
            i = k + 1;
        }
    }
    float x0 = table_byte(i);
    float x1 = table_byte(i + 1);
    return mix(table_byte(15 + i), table_byte(16 + i), (p - x0) / (x1 - x0));
}

// The nearest hardware colour of a signal target, or the pixel itself (see the header).
vec3 signal_colour(vec3 v) {
    int count = int(pc.table[0]);
    float best = 1e30;
    int index = -1;
    for (int i = 0; i < count; i++) {
        float d = distance(v, frame.target_table[TABLE_REFERENCES + i].rgb);
        if (d < best) {
            best = d;
            index = i;
        }
    }
    return (index >= 0 && best <= pc.clamp_sum) ? frame.target_table[index].rgb : v;
}

// The index G x 64 + R x 8 + B of a pixel whose three channels are 3-bit levels (the 8-bit code is the level n spread by
// repeating its bits, `n << 5 | n << 2 | n >> 1`, or 36 n; within the recovery tolerance of the code), -1 for any other pixel
// (`crt_model::target::lut_index`).
int lut_index(vec3 v) {
    vec3 code = clamp(v * 255.0, vec3(0.0), vec3(255.0));
    vec3 r = round(code);
    if (any(greaterThan(abs(code - r), vec3(RECOVERY_TOLERANCE)))) {
        return -1;
    }
    ivec3 ci = ivec3(r);
    ivec3 n = (ci + 18) / 36;
    bvec3 repeated = equal(ci, (n << 5) | (n << 2) | (n >> 1));
    bvec3 times36 = equal(ci, 36 * n);
    if (!all(bvec3(repeated.x || times36.x, repeated.y || times36.y, repeated.z || times36.z))) {
        return -1;
    }
    return n.g * 64 + n.r * 8 + n.b;
}

float curve(float x) {
    float pos = clamp(x, 0.0, 1.0) * float(CURVE_LAST);
    int i = min(int(floor(pos)), CURVE_LAST - 1);
    float f = pos - float(i);
    return mix(curve_entry(i), curve_entry(i + 1), f);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(drive_out)))) {
        return;
    }
    vec4 src = texelFetch(drive_in, p, 0);
    vec3 x = device_input(src.rgb);
    vec3 c;
    if (pc.kind == 0) {
        vec3 l = pc.input_range * (pc.input_gamma != 1.0 ? pow(max(x, vec3(0.0)), vec3(pc.input_gamma)) : x);
        vec3 s = clamp(
            vec3(dot(vec3(pc.k00, pc.k01, pc.k02), l), dot(vec3(pc.k10, pc.k11, pc.k12), l),
                 dot(vec3(pc.k20, pc.k21, pc.k22), l)),
            vec3(0.0), vec3(pc.clamp_sum));
        vec3 y = s / pc.divisor;
        c = pc.out_scale * (pc.inv_out_gamma != 1.0 ? pow(y, vec3(pc.inv_out_gamma)) : y);
    } else if (pc.kind == 1) {
        c = pc.out_scale * vec3(curve(x.r), curve(x.g), curve(x.b));
    } else if (pc.kind == 2) {
        c = pc.out_scale * palette(x);
    } else if (pc.kind == 3) {
        c = pc.out_scale * vec3(dac(x.r, 0), dac(x.g, 1), dac(x.b, 2));
    } else if (pc.kind == 5) {
        c = pc.out_scale * vec3(dac15(x.r), dac15(x.g), dac15(x.b));
    } else if (pc.kind == 6) {
        int index = lut_index(x);
        c = index >= 0 ? frame.target_table[index].rgb : x;
    } else {
        c = signal_colour(x);
    }
    imageStore(drive_out, p, round_f16(vec4(c, src.a)));
}