#version 450
#extension GL_GOOGLE_include_directive : require

// Slot `optics` (T-45), gaussians method (cost-study candidate, slow): vertical pass of the four Gaussians of
// optics_gauss_h.comp, then the halo = sum_i a_i G_i with the least-squares amplitudes pc.w[1].

#include "params.glsl"
#include "common.glsl"
#include "optics.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0, rgba16f) uniform readonly image2D in_r;
layout(set = 1, binding = 2, rgba16f) uniform readonly image2D in_g;
layout(set = 1, binding = 3, rgba16f) uniform readonly image2D in_b;
layout(set = 1, binding = 4, rgba16f) uniform writeonly image2D halo;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(halo);
    if (any(greaterThanEqual(p, sz))) {
        return;
    }
    int r = pc.info.x;
    vec4 inv2s2 = 0.5 / (pc.w[0] * pc.w[0]);
    vec4 norm = 1.0 / (pc.w[0] * 2.5066283);
    vec4 sr = vec4(0.0);
    vec4 sg = vec4(0.0);
    vec4 sb = vec4(0.0);
    int y0 = max(p.y - r, 0);
    int y1 = min(p.y + r, sz.y - 1);
    for (int y = y0; y <= y1; ++y) {
        float d = float(y - p.y);
        vec4 wt = norm * exp(-d * d * inv2s2);
        ivec2 q = ivec2(p.x, y);
        sr += wt * imageLoad(in_r, q);
        sg += wt * imageLoad(in_g, q);
        sb += wt * imageLoad(in_b, q);
    }
    vec4 a = pc.w[1];
    imageStore(halo, p, round_f16(vec4(dot(a, sr), dot(a, sg), dot(a, sb), 1.0)));
}
