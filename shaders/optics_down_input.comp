#version 450
#extension GL_GOOGLE_include_directive : require

// Slot `optics` (T-45), pyramid level 1 from the chain input: each texel is the mean of a 2 x 2 block of host
// pixels, zero outside the tube image (no light exists there), so a level-k texel is the sum of its
// 2^k x 2^k block over 4^k. See include/optics.glsl.

#include "params.glsl"
#include "common.glsl"
#include "optics.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 2) uniform sampler2D light_in;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D dst;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(dst)))) {
        return;
    }
    ivec2 ss = textureSize(light_in, 0);
    vec3 acc = vec3(0.0);
    for (int j = 0; j < 2; ++j) {
        for (int i = 0; i < 2; ++i) {
            ivec2 q = 2 * p + ivec2(i, j);
            if (all(lessThan(q, ss))) {
                acc += texelFetch(light_in, q, 0).rgb;
            }
        }
    }
    imageStore(dst, p, round_f16(vec4(0.25 * acc, 1.0)));
}
