#version 450
#extension GL_GOOGLE_include_directive : require

// Stage `decode` (ARCHITECTURE 3.7): captured BGRA8 frame -> native raster, RGBA16F.
//
// Native pixel p is read at the centre of its block in the captured frame: origin + p * div + div / 2
// (div = 1 when the source is native), with texelFetch on exact texels (DESIGN 7).
// Source interpretation (T-30, SRC-5), `params.source_eotf`:
// - drive_voltage (default): the drive voltage is V = code / 255.
// - srgb: the code is decoded with the sRGB EOTF to linear light L, and V = T^-1(L) with T the tube
//   transfer below (a pure power law of the tube gamma: V = L^(1 / gamma)), so the tube shows exactly L.
//
// CONTRACT for the voltage-domain stages and the gun law (T-34): drive_voltage() returns V in [0, 1] per
// channel, a gamma-encoded drive voltage. The value written is T(V) with the `source` transfer. Until
// the gun law exists (T-34), T stands in for it (the tube gamma, pc.transfer and pc.gamma) so that the
// chain ends in linear light; with TRANSFER_IDENTITY the raster holds V itself. T-34 replaces T by the gun
// law in gun.comp, makes this stage write V, and takes the inverse of the tube law from its own parameters.

#include "params.glsl"
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 2) uniform sampler2D src;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D native_out;

layout(push_constant) uniform Push {
    ivec2 origin;
    ivec2 div;
    uint transfer;
    float gamma;
} pc;

// Drive voltage V in [0, 1] of the captured code values (see the contract above).
vec3 drive_voltage(vec3 code) {
    if (params.source_eotf == SOURCE_EOTF_SRGB) {
        vec3 l = transfer_to_linear(code, TRANSFER_SRGB, 2.4);
        return clamp(transfer_from_linear(l, pc.transfer, pc.gamma), 0.0, 1.0);
    }
    return code;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, frame.native_size))) {
        return;
    }
    ivec2 texel = clamp(pc.origin + p * pc.div + pc.div / 2, ivec2(0), textureSize(src, 0) - 1);
    vec3 v = drive_voltage(texelFetch(src, texel, 0).rgb);
    imageStore(native_out, p, vec4(transfer_to_linear(v, pc.transfer, pc.gamma), 1.0));
}
