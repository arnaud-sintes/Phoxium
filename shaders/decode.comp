#version 450
#extension GL_GOOGLE_include_directive : require

// Stage `decode` (ARCHITECTURE 3.7): captured BGRA8 frame -> native raster, RGBA16F.
//
// Native pixel p is read at the centre of its block in the captured frame: origin + p * div + div / 2
// (div = 1 when the source is native), with texelFetch on exact texels (DESIGN 7).
// Source interpretation (T-30, SRC-5), `params.source_eotf`:
// - drive_voltage (default): the drive voltage is V = code / 255.
// - srgb: the code is decoded with the sRGB EOTF to linear light L, and V is the inverse of the NOMINAL curve
//   of the active gun law (include/gun_law.glsl: power, and gog as its power law of `gun_gamma`; BT.1886 with
//   its black lift b; the piecewise Annex 1), so that the gun shows exactly L, relative to white. The user
//   controls of the gog law (brightness, contrast, cutoff, drive) are tube controls and are not inverted.
//   Exception: a BT.1886 law with a black floor Lb / Lw cannot show a luminance below it, so the codes whose
//   L is under the floor decode to V = 0 and show the floor. `gun_gamma` is clamped to >= 0.1.
//
// CONTRACT for the voltage-domain stages and the gun law (T-34, done): drive_voltage() returns V in [0, 1]
// per channel, a gamma-encoded drive voltage, and with the default pc.transfer = TRANSFER_IDENTITY that
// is what is written to the native raster: the gun law is applied by `gun.comp` (slot `gun`), not here.
// A disabled `gun` slot passes V through bit for bit, and `encode` then treats V as linear light: the
// picture comes out LIGHTER than with the gun on (V is a gamma-encoded value shown as if it were light;
// code 20 shows about code 80 on a pure 2.2 host instead of 20), not darker.
// Monochrome phosphor type (params.phosphor_type other than p22, QUESTIONS PHY-19; src/phosphor_type.rs): one gun, so the
// three channels carry the BT.601 luma Y' = 0.299 R' + 0.587 G' + 0.114 B' of the gamma-encoded code values (the weights of
// crt_model::composite::LUMA, oracle crt_model::phosphor_types::mono_drive), taken before the drive voltage and the gun
// law. P22 does not take the branch (bit for bit unchanged).
// Flip (`source_flip`, applied to the upright picture after the quarter turn) mirrors the block index.
// Pre-filter (`source_prefilter`, oracle crt_model::prefilter): with a divisor above 1 a native pixel can be read as
// a kernel-weighted sum of the captured texels around its block's centre (box, triangle, Lanczos 2 and 3, sinc)
// instead of the one centre texel; with a divisor of 1 or `point` the texel is read as before, bit for bit.
// pc.transfer and pc.gamma (Settings::source) remain only as an optional transfer applied to V after the
// drive voltage, for tests of the pre-T-34 chain; the default is the identity.

#include "params.glsl"
#include "common.glsl"
#include "gun_law.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 2) uniform sampler2D src;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D native_out;

layout(push_constant) uniform Push {
    ivec2 origin;
    ivec2 div;
    uint transfer;
    float gamma;
} pc;

const float PI = 3.14159265358979;
const int PREFILTER_MAX_TEXELS = 16;

float sinc(float x) {
    if (x == 0.0) {
        return 1.0;
    }
    float t = PI * x;
    return sin(t) / t;
}

// The kernel at distance x native pixels (crt_model::prefilter::weight).
float prefilter_weight(float x) {
    float a = abs(x);
    switch (params.source_prefilter) {
        case SOURCE_PREFILTER_BOX:
            return a < 0.5 ? 1.0 : 0.0;
        case SOURCE_PREFILTER_TRIANGLE:
            return max(1.0 - a, 0.0);
        case SOURCE_PREFILTER_LANCZOS2:
            return a < 2.0 ? sinc(a) * sinc(a / 2.0) : 0.0;
        case SOURCE_PREFILTER_LANCZOS3:
            return a < 3.0 ? sinc(a) * sinc(a / 3.0) : 0.0;
        case SOURCE_PREFILTER_SINC:
            return a < 4.0 ? sinc(a) : 0.0;
    }
    return a == 0.0 ? 1.0 : 0.0;
}

float prefilter_radius() {
    switch (params.source_prefilter) {
        case SOURCE_PREFILTER_BOX:
            return 0.5;
        case SOURCE_PREFILTER_TRIANGLE:
            return 1.0;
        case SOURCE_PREFILTER_LANCZOS2:
            return 2.0;
        case SOURCE_PREFILTER_LANCZOS3:
            return 3.0;
        case SOURCE_PREFILTER_SINC:
            return 4.0;
    }
    return 0.0;
}

// The captured code values of the native pixel whose block is `b` (the index in the upright picture).
vec3 captured_code(ivec2 b) {
    ivec2 size = textureSize(src, 0);
    ivec2 start = pc.origin + b * pc.div;
    if (params.source_prefilter == SOURCE_PREFILTER_POINT || pc.div == ivec2(1)) {
        return texelFetch(src, clamp(start + pc.div / 2, ivec2(0), size - 1), 0).rgb;
    }
    // The picture area (the crop rectangle of the view, inside the frame): the taps repeat its edge texel, so the bars
    // or the window chrome around a cropped picture never leak into its edge pixels (oracle prefilter::filter).
    bool turned = params.source_rotation != SOURCE_ROTATION_OFF;
    ivec2 upright = turned ? frame.native_size.yx : frame.native_size;
    ivec2 area_lo = clamp(pc.origin, ivec2(0), size - 1);
    ivec2 area_hi = clamp(pc.origin + upright * pc.div - 1, area_lo, size - 1);
    float radius = prefilter_radius();
    vec2 centre = vec2(start) + 0.5 * vec2(pc.div);
    ivec2 c = ivec2(floor(centre));
    ivec2 reach = clamp(ivec2(ceil(radius * vec2(pc.div))), ivec2(0), ivec2(PREFILTER_MAX_TEXELS));
    vec3 acc = vec3(0.0);
    float sum = 0.0;
    for (int y = c.y - reach.y; y <= c.y + reach.y; y++) {
        float wy = prefilter_weight((float(y) + 0.5 - centre.y) / float(pc.div.y));
        if (wy == 0.0) {
            continue;
        }
        for (int x = c.x - reach.x; x <= c.x + reach.x; x++) {
            float w = wy * prefilter_weight((float(x) + 0.5 - centre.x) / float(pc.div.x));
            if (w == 0.0) {
                continue;
            }
            acc += w * texelFetch(src, clamp(ivec2(x, y), area_lo, area_hi), 0).rgb;
            sum += w;
        }
    }
    if (abs(sum) < 1e-12) {
        return texelFetch(src, clamp(start + pc.div / 2, ivec2(0), size - 1), 0).rgb;
    }
    return clamp(acc / sum, 0.0, 1.0);
}

// Drive voltage V in [0, 1] of the captured code values (see the contract above).
vec3 drive_voltage(vec3 code) {
    if (params.source_eotf == SOURCE_EOTF_SRGB) {
        vec3 l = transfer_to_linear(code, TRANSFER_SRGB, 2.4);
        return clamp(vec3(gun_nominal_inverse(l.r), gun_nominal_inverse(l.g), gun_nominal_inverse(l.b)), 0.0, 1.0);
    }
    return code;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, frame.native_size))) {
        return;
    }
    // TATE (`source_rotation`): the native raster is the upright picture turned a quarter turn, so that the
    // scanlines (native rows) are the columns of the upright picture. The native size is already the turned
    // size (`View::native`); b is the block of the upright picture that native pixel p shows. Counter-clockwise:
    // the first scanline is the rightmost column; clockwise: the leftmost (the same maps as `encode` inverts).
    ivec2 b = p;
    if (params.source_rotation == SOURCE_ROTATION_COUNTER_CLOCKWISE) {
        b = ivec2(p.y, frame.native_size.x - 1 - p.x);
    } else if (params.source_rotation == SOURCE_ROTATION_CLOCKWISE) {
        b = ivec2(frame.native_size.y - 1 - p.y, p.x);
    }
    // Flip of the upright picture (its size: the native size, with the sides swapped when turned).
    if (params.source_flip != SOURCE_FLIP_OFF) {
        bool turned = params.source_rotation != SOURCE_ROTATION_OFF;
        ivec2 upright = turned ? frame.native_size.yx : frame.native_size;
        if (params.source_flip == SOURCE_FLIP_HORIZONTAL || params.source_flip == SOURCE_FLIP_BOTH) {
            b.x = upright.x - 1 - b.x;
        }
        if (params.source_flip == SOURCE_FLIP_VERTICAL || params.source_flip == SOURCE_FLIP_BOTH) {
            b.y = upright.y - 1 - b.y;
        }
    }
    vec3 code = captured_code(b);
    if (params.phosphor_type != PHOSPHOR_TYPE_P22) {
        code = vec3(dot(code, vec3(0.299, 0.587, 0.114)));
    }
    vec3 v = drive_voltage(code);
    imageStore(native_out, p, round_f16(vec4(transfer_to_linear(v, pc.transfer, pc.gamma), 1.0)));
}
