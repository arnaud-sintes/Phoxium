#version 450
#extension GL_GOOGLE_include_directive : require

// Slot `gun` (ARCHITECTURE 3.7, image contract; T-34, QUESTIONS PHY-6 and COL-2): amp domain -> amp
// domain, drive voltage V in [0, 1] (the output contract of `decode`, through `signal` and `amp`) to beam
// current I per channel. I is relative: 1 at full drive for the power, BT.1886 and Annex 1 laws.
//
// Laws, `params.gun_law` (formulas, domains and slopes in include/gun_law.glsl; CRT.md "Gun law"):
// - power:         I = V^gamma.
// - gog:           I = drive_c * max(gain V + offset + cutoff_c, 0)^gamma (Berns, Motta and Gorzynski 1993).
// - bt1886:        I = L / Lw (black floor Lb / Lw at V = 0).
// - bt1886_annex1: I = L / Lw of the two-exponent Annex 1 law.
// Every law is multiplied by `frame.white_gain`: the white retune of COL-2, relative to the tube white, so
// (1, 1, 1) when `gun_white_balance` is off and also when the retune target is the tube white.
// A power law with gamma exactly 1 returns V unchanged (no pow, so the identity is bit exact). gun_gamma is
// clamped to >= 0.1 (include/gun_law.glsl).
//
// Reads the amp output (binding 2) and writes its own image (binding 3), both amp_size(): no in-place
// update (every chain stage writes a new image).

#include "params.glsl"
#include "common.glsl"
#include "gun_law.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 2) uniform sampler2D drive_in;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D current_out;

// Beam current of the three guns for the drive voltages `v`.
vec3 gun_current(vec3 v) {
    float gamma = gun_gamma();
    vec3 i;
    if (params.gun_law == GUN_LAW_GOG) {
        vec3 u = params.gun_gain * v + params.gun_offset + params.gun_cutoff_rgb;
        i = vec3(power_law(u.r, gamma), power_law(u.g, gamma), power_law(u.b, gamma)) * params.gun_drive_rgb;
    } else if (params.gun_law == GUN_LAW_BT1886) {
        i = vec3(bt1886(v.r), bt1886(v.g), bt1886(v.b));
    } else if (params.gun_law == GUN_LAW_BT1886_ANNEX1) {
        i = vec3(bt1886_annex1(v.r), bt1886_annex1(v.g), bt1886_annex1(v.b));
    } else {
        i = vec3(power_law(v.r, gamma), power_law(v.g, gamma), power_law(v.b, gamma));
    }
    return i * frame.white_gain;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(current_out)))) {
        return;
    }
    vec4 drive = texelFetch(drive_in, p, 0);
    imageStore(current_out, p, vec4(gun_current(drive.rgb), drive.a));
}
