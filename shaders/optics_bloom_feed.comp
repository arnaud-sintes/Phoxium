#version 450
#extension GL_GOOGLE_include_directive : require

// Slot `optics`, bloom with a threshold (owner request 2026-11-20; oracle crt_model::optics::Bloom): level 1 of
// the bloom's feed pyramid. Each texel is the mean of a 2 x 2 block of host pixels of q(p) L(p), the light each
// pixel gives to the bloom: q the soft-knee feed fraction (opt_bloom_feed) of the brightest channel of the light
// averaged at about half the dominant lobe's size, a bilinear read of the stage's own pyramid level k_q (bound as
// OPT_SRC). Zero outside the tube image, as optics_down_input.comp; the higher levels are optics_down.comp.
//
// pc.info: y the knee level k_q. The threshold is params.optics_bloom_threshold.

#include "params.glsl"
#include "common.glsl"
#include "optics.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 2) uniform sampler2D light_in;
layout(set = 1, binding = 0, rgba16f) uniform readonly image2D knee_level;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D dst;

OPT_BILINEAR(bilin_knee, knee_level)

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(dst)))) {
        return;
    }
    ivec2 ss = textureSize(light_in, 0);
    float t = params.optics_bloom_threshold;
    int kq = pc.info.y;
    vec3 acc = vec3(0.0);
    for (int j = 0; j < 2; ++j) {
        for (int i = 0; i < 2; ++i) {
            ivec2 q = 2 * p + ivec2(i, j);
            if (all(lessThan(q, ss))) {
                vec3 m = bilin_knee(q, kq);
                float f = opt_bloom_feed(max(m.r, max(m.g, m.b)), t);
                acc += f * texelFetch(light_in, q, 0).rgb;
            }
        }
    }
    imageStore(dst, p, round_f16(vec4(0.25 * acc, 1.0)));
}
